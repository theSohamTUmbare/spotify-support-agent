# Copy to .env and fill in your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# The live agent + demo use this model. gemini-3.5-flash-lite has the highest free-tier
# limits; any flash / flash-lite model works.
GEMINI_MODEL=gemini-3.5-flash-lite

# The eval harness can use separate models for the agent and the LLM-judge — this keeps
# the judge INDEPENDENT of the agent it grades, and spreads load across the per-model
# free-tier daily quota (500 requests / model / day). Defaults shown; override if you like.
AGENT_MODEL=gemini-2.5-flash-lite
JUDGE_MODEL=gemini-2.5-flash

# --- Groq (automatic fallback when Gemini fails/quota-caps; also runs the eval) ---
# Free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Run the eval live on Groq (used to produce the committed results):
# AGENT_PROVIDER=groq  AGENT_MODEL=openai/gpt-oss-120b
# JUDGE_PROVIDER=groq  JUDGE_MODEL=openai/gpt-oss-20b

# Optional:
# LLM_PROVIDER=groq          # force the live agent onto Groq instead of Gemini-first
# GEMINI_TEMPERATURE=0.2
# GEMINI_MIN_INTERVAL_S=4.2  # client-side pacing under the per-minute rate limit
# GROQ_MIN_INTERVAL_S=2.1
